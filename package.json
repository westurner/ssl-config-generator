{
  "name": "tlsref-configurator",
  "version": "5.7.1",
  "description": "TLSRef configurator",
  "license": "MPL-2.0",
  "scripts": {
    "analyze": "NODE_ENV=analyze webpack --config=config/webpack.config.js --progress",
    "build": "NODE_ENV=production webpack --config=config/webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config=config/webpack.config.js --watch --progress",
    "start": "npm run watch",
    "test": "node --require @babel/register --test test/*.test.js",
    "render-grid": "node --require @babel/register scripts/render-grid.js",
    "screenshots": "SCG_GEN_SCREENSHOTS=1 node scripts/screenshot.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tlsref/configurator.git"
  },
  "bugs": {
    "url": "https://github.com/tlsref/configurator/issues"
  },
  "homepage": "https://configurator.tlsref.org/",
  "dependencies": {
    "bootstrap.native": "^5.1.10",
    "clipboard": "^2.0.11",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-object-rest-spread": "^7.28.6",
    "@babel/preset-env": "^7.29.2",
    "@babel/register": "^7.28.6",
    "babel-loader": "^10.1.1",
    "browser-sync": "^3.0.4",
    "browser-sync-v3-webpack-plugin": "^0.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "ejs-easy-loader": "^0.1.4",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.7",
    "lodash.assign": "^4.2.0",
    "lodash.clonedeep": "^4.5.0",
    "mini-css-extract-plugin": "^2.10.2",
    "path-browserify": "^1.0.1",
    "postcss-loader": "^8.2.1",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.7",
    "webpack": "^5.106.2",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^7.0.2"
  }
}
