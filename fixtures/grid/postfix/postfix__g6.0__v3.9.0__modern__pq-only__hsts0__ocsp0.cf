# generated 1970-01-01, Mozilla Guideline v6.0, Postfix 3.9.0, OpenSSL 3.6.1, modern config, PQ: only
# https://ssl-config.mozilla.org/#server=postfix&version=3.9.0&config=modern&openssl=3.6.1&guideline=6.0&pq=only
smtpd_tls_auth_only = yes
smtpd_tls_chain_files =
  /path/to/private_key,
  /path/to/signed_cert_plus_intermediates
smtpd_tls_security_level = may
smtpd_tls_mandatory_protocols = >=TLSv1.3
smtpd_tls_protocols           = >=TLSv1.3

smtp_tls_security_level = may
smtp_tls_mandatory_protocols  = >=TLSv1.3
smtp_tls_protocols            = >=TLSv1.3

tls_preempt_cipherlist = no
tls_eecdh_auto_curves = X25519MLKEM768
tls_ffdhe_auto_groups =
