# generated 1970-01-01, TLSRef Guideline v6.0, Postfix 3.9.0, OpenSSL 4.0.0, intermediate config, PQ: none
# https://ssl-config.mozilla.org/#server=postfix&version=3.9.0&config=intermediate&openssl=4.0.0&guideline=6.0&hsts=false&ocsp=false&pq=none
smtpd_tls_auth_only = yes
smtpd_tls_chain_files =
  /path/to/private_key,
  /path/to/signed_cert_plus_intermediates
smtpd_tls_security_level = may
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_protocols           = >=TLSv1.2

smtp_tls_security_level = may
smtp_tls_mandatory_protocols  = >=TLSv1.2
smtp_tls_protocols            = >=TLSv1.2

tls_preempt_cipherlist = no
tls_eecdh_auto_curves = X25519 prime256v1 secp384r1
tls_ffdhe_auto_groups =
smtp_tls_mandatory_ciphers = medium
smtpd_tls_mandatory_ciphers = medium
tls_medium_cipherlist = ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
