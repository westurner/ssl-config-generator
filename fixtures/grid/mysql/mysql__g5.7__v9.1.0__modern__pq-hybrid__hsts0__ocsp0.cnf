# generated 1970-01-01, Mozilla Guideline v5.7, MySQL 9.1.0, OpenSSL 3.6.1, modern config, PQ: hybrid
# https://ssl-config.mozilla.org/#server=mysql&version=9.1.0&config=modern&openssl=3.6.1&guideline=5.7&hsts=false&ocsp=false&pq=hybrid
[mysqld]
require_secure_transport = on
ssl-cert = /path/to/signed_cert_plus_intermediates
ssl-key = /path/to/private_key
tls_version = TLSv1.3

# Post-quantum (ML-KEM hybrid) key exchange:
#   This server has no native TLS group / curve directive; ML-KEM
#   hybrid groups (e.g. X25519MLKEM768) reach the wire only if the
#   linked OpenSSL is configured to offer them via openssl.cnf, in
#   the [system_default_sect] Groups = … line. See the
#   "OpenSSL (openssl.cnf)" target in this generator for a
#   ready-to-paste snippet, and locate your active openssl.cnf with:
#       openssl version -d
#   To use a different openssl.cnf for THIS process only (e.g. when
#   you do not want to change the system-wide file), set the
#   OPENSSL_CONF environment variable before launching the server:
#       OPENSSL_CONF=/path/to/your-openssl.cnf <server-binary> ...
#   The OPENSSL_CONF override has been honoured by libssl since
#   OpenSSL 0.9.7 (see openssl-config(5) / OPENSSL_init_crypto(3)).
