# generated 1970-01-01, Mozilla Guideline v5.7, Caddy 2.8.4, intermediate config, PQ: only
# https://ssl-config.mozilla.org/#server=caddy&version=2.8.4&config=intermediate&guideline=5.7&pq=only

# replace example.com with your domain name
example.com {

  tls {
    # Note: Caddy automatically configures safe TLS settings,
    # so 'ciphers' and 'curves' may safely be commented out to use Caddy defaults.
    ciphers TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256

    # PQ-only: Caddy currently only exposes the X25519MLKEM768 hybrid
    # group (other PQ groups from the guideline are filtered out).
    curves x25519mlkem768
    protocols tls1.3
  }

}
